# Copy to .env in the repository root, then fill in the values.
# Spring Boot does not read .env automatically; export it before bootRun.
SPRING_PROFILES_ACTIVE=dev

# Create a matching PostgreSQL role and database before starting the API.
DATABASE_URL=jdbc:postgresql://localhost:5432/scrum_app_dev
DB_USERNAME=scrum_app
DB_PASSWORD=

# Generate each secret separately with: openssl rand -hex 32
# JWT_SECRET must have at least 32 characters.
# PROJECT_KEY_MASTER_KEY must be 64 hexadecimal characters for AES-256.
# Keep the master key stable: existing encrypted project keys depend on it.
JWT_SECRET=
PROJECT_KEY_MASTER_KEY=
PROJECT_KEY_EXPIRATION_DAYS=30
PROJECT_KEY_LENGTH=8

# The dev profile fixes CORS to these two local frontend origins.
# For the prod profile, set the actual deployed frontend origin here.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
